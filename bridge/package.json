{
  "name": "pi-remote-bridge",
  "version": "0.1.0",
  "description": "Pi Remote bridge — aggregates local pi sessions and exposes an authenticated LAN/VPN API for the Pi Remote iPhone app.",
  "type": "module",
  "bin": {
    "pi-remote-bridge": "./dist/bridge/src/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bridge/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
